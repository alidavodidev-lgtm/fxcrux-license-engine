<Window x:Class="FXCrux.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FXCrux Hub - Secure Login" Height="500" Width="400"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="15" Background="#0A0A0A">
        <Grid>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40"
                    Background="Transparent" Foreground="#404040" BorderBrush="Transparent"
                    FontSize="16" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="40,20,40,20">

                <Image Source="Resources/LogoMark.png" Width="64" Height="64" Margin="0,0,0,15"/>

                <TextBlock Text="COMMAND CENTER" Foreground="#FFFFFF" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="Hardware Authentication Gate" Foreground="#AA8C2C" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,35"/>

                <TextBlock Text="USERNAME" Foreground="#525252" FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                <TextBox x:Name="TxtUsername" Height="45" Background="#000000" Foreground="#FFFFFF"
                         BorderBrush="#262626" BorderThickness="1" Padding="15,12,15,10" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="PASSWORD" Foreground="#525252" FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" Height="45" Background="#000000" Foreground="#FFFFFF"
                             BorderBrush="#262626" BorderThickness="1" Padding="15,12,15,10" FontSize="14" Margin="0,0,0,25"/>

                <Button x:Name="BtnLogin" Content="INITIALIZE SESSION" Height="45" Margin="0,0,0,15"
                        Background="#D4AF37" Foreground="#000000" FontWeight="Black" FontSize="13"
                        BorderBrush="Transparent" Cursor="Hand" Click="BtnLogin_Click"/>

                <Border Background="#000000" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock x:Name="TxtStatus" Text="System ready. Awaiting credentials..." Foreground="#525252" FontSize="11"
                               HorizontalAlignment="Left" TextWrapping="Wrap" FontFamily="Consolas"/>
                </Border>

            </StackPanel>

            <!-- Loading overlay, shown while authenticating -->
            <Grid x:Name="LoadingOverlay" Background="#CC000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="48" Height="48" StrokeThickness="4" Stroke="#D4AF37" StrokeDashArray="4 3" HorizontalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" CenterX="24" CenterY="24"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="AUTHENTICATING..." Foreground="#D4AF37" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>