<Window x:Class="FXCrux.UI.AppHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FXCrux App Hub" Height="700" Width="560"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="15" Background="#0A0A0A">
        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="22,16,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/LogoMark.png" Width="34" Height="34" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="FXCRUX APP HUB" Foreground="#FFFFFF" FontSize="19" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="BtnRefresh" Content="⟳" Width="38" Height="38"
                            Background="Transparent" Foreground="#D4AF37" BorderBrush="Transparent"
                            FontSize="19" FontWeight="Bold" Cursor="Hand" Click="BtnRefresh_Click"
                            ToolTip="Refresh your app list and license status"/>
                    <Button x:Name="BtnClose" Content="✕" Width="38" Height="38"
                            Background="Transparent" Foreground="#606060" BorderBrush="Transparent"
                            FontSize="16" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Account header -->
            <Border Grid.Row="1" Background="#000000" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Margin="20,16,20,12" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TxtUsername" Text="—" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtMachineId" Text="Machine: —" Foreground="#ABABAB" FontSize="13" FontFamily="Consolas" Margin="0,5,0,0"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="PAIRING CODE (select manually or use Copy - paste into an EA/indicator's inputs)" Foreground="#7A7A7A" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                            <!-- A real, always-selectable TextBox rather than a TextBlock: the Windows
                                 clipboard can be grabbed by other software (download managers, clipboard
                                 tools) in a way that makes the automated Copy button unreliable on some
                                 machines - manual select-all + Ctrl+C must always work regardless, since
                                 we can't control what's running on a customer's PC. -->
                            <TextBox x:Name="TxtPairingCode" Text="—" Foreground="#D4AF37" Background="Transparent" BorderThickness="0"
                                     FontSize="15" FontFamily="Consolas" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     Padding="0" Margin="0,4,0,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnCopyPairing" Content="COPY" Width="68" Height="30" FontSize="12" FontWeight="Bold"
                                Background="#1A1A1A" Foreground="#D4AF37" BorderBrush="#262626" Cursor="Hand" Click="BtnCopyPairing_Click"
                                VerticalAlignment="Center" ToolTip="If Copy fails, click into the code above, press Ctrl+A then Ctrl+C"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- App list -->
            <ScrollViewer Grid.Row="2" Margin="20,0,20,12" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AppListPanel"/>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="#000000" BorderBrush="#262626" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Margin="20,0,20,20" Padding="12">
                <TextBlock x:Name="TxtStatus" Text="Ready." Foreground="#9A9A9A" FontSize="13" TextWrapping="Wrap" FontFamily="Consolas"/>
            </Border>

            <!-- Loading overlay, shown while the initial app list is fetched -->
            <Grid x:Name="LoadingOverlay" Grid.RowSpan="4" Background="#CC000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="44" Height="44" StrokeThickness="3" Stroke="#D4AF37" StrokeDashArray="4 3" HorizontalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" CenterX="22" CenterY="22"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="TxtLoadingLabel" Text="LOADING YOUR APPS..." Foreground="#D4AF37" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
