<Window x:Class="FXCrux.UI.TerminalPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Broker Terminal(s)" Height="360" Width="360"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="15" Background="#0A0A0A">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="SELECT TERMINAL(S)" Foreground="#FFFFFF" FontSize="16" FontWeight="Black"/>
            <TextBlock Grid.Row="1" Text="Install into which broker terminal(s)?" Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,12"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TerminalListPanel"/>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnCancel" Content="CANCEL" Width="80" Height="32" Margin="0,0,10,0"
                        Background="#1A1A1A" Foreground="#808080" BorderBrush="#262626" FontSize="10" FontWeight="Bold"
                        Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnInstall" Content="INSTALL" Width="90" Height="32"
                        Background="#D4AF37" Foreground="#000000" BorderBrush="Transparent" FontSize="10" FontWeight="Black"
                        Cursor="Hand" Click="BtnInstall_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
